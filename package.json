{
  "name": "@vinsidious/mcp-pg-schema",
  "version": "0.3.0",
  "description": "MCP server for PostgreSQL schema inspection via Docker (supports direct connection, SSH tunnels, and static SQL files)",
  "license": "MIT",
  "author": "Vince Coppola <vincecoppola@gmail.com>",
  "type": "module",
  "bin": {
    "mcp-pg-schema": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.1",
    "pg": "^8.13.0",
    "ssh2": "^1.15.0",
    "sql-parser-cst": "^1.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  }
}

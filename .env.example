# PostgreSQL Connection Configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

# PostgreSQL Host
# - For localhost: use "host.docker.internal" (macOS/Windows) or "localhost" with --network=host (Linux)
# - For Docker network: use the container name (e.g., "postgres")
PGHOST=postgres

# PostgreSQL Port
PGPORT=5432

# Database name
PGDATABASE=srs

# Database user
PGUSER=srs_alpha

# Database password (REQUIRED)
PGPASSWORD=your_password_here

# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
PGSSLMODE=disable

# Docker network (if PostgreSQL is in a Docker network)
DOCKER_NETWORK=srs_default

{
  "servers": {
    // PostgreSQL Schema MCP Server - Read-only database schema metadata access
    //
    // RECOMMENDED: Use the wrapper script with environment variables
    //
    // Setup:
    //   1. Copy .env.example to .env and fill in your credentials
    //   2. Source .env in your shell before launching VS Code:
    //      cd /path/to/mcp-pg-schema && source .env && code .
    //   3. Or add to ~/.bashrc or ~/.zshrc:
    //      if [ -f /path/to/mcp-pg-schema/.env ]; then
    //        export $(cat /path/to/mcp-pg-schema/.env | grep -v '^#' | xargs)
    //      fi
    //
    // Available Tools:
    //   - list_schemas: List all database schemas
    //   - list_tables: List tables (optionally by schema)
    //   - table_schema: Get detailed table metadata (columns, constraints, indexes)
    //   - schema: Get all tables in a schema with relationships
    //   - composite_types: List user-defined types
    //   - functions: List function signatures
    //
    // Note: Provides metadata only, no access to actual table data
    //
    "postgres-srs": {
      "type": "stdio",
      // Update this path to match your installation
      "command": "/absolute/path/to/mcp-pg-schema/scripts/mcp-postgres-srs",
      "args": []
    }
  },
  "inputs": []
}

